# Copy to `.env` for local development: cp .env.example .env
# `.env` is gitignored and must never be baked into the Docker image.

# Message returned by the /secret route once Basic Auth succeeds.
SECRET_MESSAGE=This is the secret message

# Credentials for Basic Auth on /secret.
USERNAME=admin
PASSWORD=supersecret

# Optional: port the service listens on (default 80).
PORT=3000
